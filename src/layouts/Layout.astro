---
import '../styles/global.css';
import { href } from '../lib/puzzles';
const { title = '今日のAI謎' } = Astro.props;
---
<!doctype html>
<html lang="ja">
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><title>{title} | 今日のAI謎</title>
<link rel="apple-touch-icon" sizes="180x180" href={href('apple-touch-icon.png')} />
<link rel="icon" type="image/png" sizes="32x32" href={href('favicon-32.png')} />
<link rel="manifest" href={href('site.webmanifest')} />
<meta name="apple-mobile-web-app-title" content="今日のAI謎" />
<meta name="theme-color" content="#181818" />
</head>
<body>
<header><a href={href()}>今日のAI謎</a><a href={href('archive/')}>過去の謎</a></header>
<main><slot /></main>
<footer>毎日の、ひらめきを。<br />正解の記録はこの端末に保存されます。</footer>
<script>import '../scripts/answer.js';</script>
</body></html>
