---
import Layout from '../layouts/Layout.astro';
import Listing from '../components/Listing.astro';
import { publishedPuzzles, href, puzzleUrl } from '../lib/puzzles';
const puzzles = await publishedPuzzles();
const p = puzzles[0].data;
---
<Layout>
<h1>最新の謎</h1>
<div class="carousel" aria-label="最新7問">
<div class="carousel-viewport"><div class="carousel-track" tabindex="0" aria-label="左右キーで謎を選択">{puzzles.slice(0,7).map(({data:item},i) => <article class="carousel-slide" aria-label={`${i+1} / ${Math.min(7,puzzles.length)}`}>
<a class="puzzle-image" href={puzzleUrl(item.date)}><img src={href(item.image)} width="1600" height="1200" alt={item.alt} loading={i===0?'eager':'lazy'} /></a><div class="issue"><a class="text-link" href={puzzleUrl(item.date)}>この謎を解く →</a></div>
</article>)}</div>
<button class="carousel-arrow prev" type="button" data-carousel-prev aria-label="前の謎">‹</button><button class="carousel-arrow next" type="button" data-carousel-next aria-label="次の謎">›</button></div>
<button class="carousel-pause" type="button" data-carousel-pause aria-label="自動送りを停止">Ⅱ</button>
</div>
<section><h2>これまでの謎</h2><Listing puzzles={puzzles.filter(({data:item})=>item.date.slice(0,7)===p.date.slice(0,7))} /><a class="text-link" href={href('archive/')}>すべての謎を見る →</a></section>
</Layout>
