---
import Layout from '../layouts/Layout.astro';
import Listing from '../components/Listing.astro';
import { publishedPuzzles, href, puzzleUrl } from '../lib/puzzles';
const puzzles = await publishedPuzzles();
const p = puzzles[0].data;
---
<Layout>
<p class="eyebrow">一日一問、ひらめく時間。</p><h1 id="latest-heading" data-date={p.date}>最新の謎</h1>
<p class="intro">見方を変えると、答えが見えてくる。</p>
<div class="carousel" aria-label="最新7問">
<div class="carousel-track" tabindex="0" aria-label="左右にスクロールして謎を選択">{puzzles.slice(0,7).map(({data:item},i) => <article class="carousel-slide" aria-label={`${i+1} / ${Math.min(7,puzzles.length)}`}>
<a class="puzzle-image" href={puzzleUrl(item.date)}><img src={href(item.image)} width="1600" height="1200" alt={item.alt} loading={i===0?'eager':'lazy'} /></a><div class="issue"><time>{item.date}</time><a class="text-link" href={puzzleUrl(item.date)}>この謎を解く →</a></div>
</article>)}</div>
<div class="carousel-controls"><button type="button" data-carousel-prev aria-label="前の謎">←</button><span data-carousel-count aria-live="polite">1 / {Math.min(7,puzzles.length)}</span><button type="button" data-carousel-next aria-label="次の謎">→</button></div>
</div>
<section><h2>これまでの謎</h2><Listing puzzles={puzzles.filter(({data:item})=>item.date.slice(0,7)===p.date.slice(0,7))} /><a class="text-link" href={href('archive/')}>すべての謎を見る →</a></section>
</Layout>
