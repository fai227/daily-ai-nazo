---
import Layout from '../layouts/Layout.astro';
import Listing from '../components/Listing.astro';
import { publishedPuzzles, href, puzzleUrl } from '../lib/puzzles';
const puzzles = await publishedPuzzles();
const p = puzzles[0].data;
---
<Layout>
<p class="eyebrow">一日一問、ひらめく時間。</p><h1 id="latest-heading" data-date={p.date}>最新の謎</h1>
<p class="intro">見方を変えると、答えが見えてくる。</p>
<a class="puzzle-image" href={puzzleUrl(p.date)}><img src={href(p.image)} width="1600" height="1200" alt={p.alt} /></a>
<div class="issue"><time>{p.date}</time><a class="text-link" href={puzzleUrl(p.date)}>この謎を解く →</a></div>
<section><h2>これまでの謎</h2><Listing puzzles={puzzles.slice(0,7)} /><a class="text-link" href={href('archive/')}>すべての謎を見る →</a></section>
</Layout>
