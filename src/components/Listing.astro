---
import { puzzleUrl } from '../lib/puzzles';
const { puzzles } = Astro.props;
const months = [...new Set(puzzles.map(({data:p}) => p.date.slice(0,7)))].sort().reverse();
---

<div class="calendars">{months.map(month => {
 const [year,m] = month.split('-').map(Number);
 const offset = new Date(Date.UTC(year,m-1,1)).getUTCDay();
 const days = new Date(Date.UTC(year,m,0)).getUTCDate();
 return <section class="calendar-month"><h2>{year}年{m}月</h2><div class="calendar-grid">
 {['日','月','火','水','木','金','土'].map(s => <span class="weekday">{s}</span>)}
 {Array.from({length:offset},()=> <span aria-hidden="true"></span>)}
 {Array.from({length:days},(_,i)=>{const date=`${month}-${String(i+1).padStart(2,'0')}`;const item=puzzles.find(({data:p})=>p.date===date);return item ? <a class="calendar-day" href={puzzleUrl(date)} aria-label={`${date}の謎・未クリア`} data-calendar-date={date}><time datetime={date}>{i+1}</time><span class="unread-dot" data-solved={`${date}:${item.data.revision}`} aria-label="未クリア"></span></a> : <span class="calendar-empty">{i+1}</span>;})}
 </div></section>;
})}</div>
